[Unit]
Description=世界核心 · 投影服务（只读消费者）
Documentation=man:systemd.service(5)
# 用 Wants（不用 Requires）：投影没起来，世界照常读写
Wants=world-core.service
After=world-core.service

[Service]
Type=exec
# ★★ 2026-10-05：`ExecStart` 少了那个 `<socket>` 参数 —— 而它【今天之前从未跑起来过】。
#   两个病因【叠在一起】，两个都在 journal 里逐字可读：
#   ① 少参数 ⇒ 进程自己打印 `用法: world-core --ledger <path> project serve <socket>` ⇒ `status=1/FAILURE`；
#   ② 补上参数后，`User=world-projectd`（uid 964）**读不到账本** ⇒ 逐字
#      `ext.world.ProjectServe.LedgerUnreadable: /var/lib/world-core/ledger.jsonl 读不到：Permission denied (os error 13)`
#      —— 因为 `/var/lib/world-core/` 是 `drwx------ world-core`（`StateDirectoryMode=0700`）。
#   ⇒ 而 `Restart=on-failure` ⇒ 它一直在重启（`restart counter is at 4`），
#     **而没有任何判据会因此变红**（`check.sh` 不起服务；`carrier_contract` 只静态读单元件）。
#   ★ 处置（本批）：补上 socket 路径 ＋ 改 `User=world-core`；"只读"改由**构造**保证 ——
#     本进程**只 `File::open` 账本读、从不开写句柄**，外加下面四条沙箱（`ProtectSystem=strict`／
#     `ReadOnlyPaths`／`NoNewPrivileges`／`RestrictAddressFamilies`）。
#   ★★ 出口路径放在**它自己的运行目录**（`/run/world-projectd/`），不挤进 `/run/world-core/` ——
#     后者的属主与模式是「口 → 身份」那条链的物证，不该被第三个口搅进去。
ExecStart=/usr/bin/world-core --ontology /etc/world-core/ontology.json --ledger /var/lib/world-core/ledger.jsonl --policy /etc/world-core/policy.json project serve /run/world-projectd/project.sock
Restart=on-failure
RestartSec=2s

# ★ 只读身份：见上 —— 读账本需要能进入状态目录，故本批用 `world-core`；
#   "不许写"由"从不开写句柄"＋ 沙箱保证（**不是**靠另一个 uid）
User=world-core
Group=world-core
RuntimeDirectory=world-projectd
RuntimeDirectoryMode=0755

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
# 只读挂载状态目录（真实拦阻来自文件属主与模式）
ReadOnlyPaths=/var/lib/world-core

MemoryMax=1G
CPUQuota=50%
TasksMax=32

[Install]
WantedBy=multi-user.target
