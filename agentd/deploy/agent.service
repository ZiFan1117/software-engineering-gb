[Unit]
Description=System agent runtime (agentd)
After=multi-user.target

[Service]
ExecStart=/usr/bin/agentd --cap-dir=/etc/agent/cap.d --listen=unix:///run/agentd/agentd.sock --audit-file=/var/lib/agentd/audit.jsonl --jobs-store=/var/lib/agentd/jobs.json
User=agent
MemoryMax=4G
CPUQuota=200%
TasksMax=512
ProtectSystem=strict
ReadWritePaths=/home/user/Work /var/lib/agentd /run/agentd
PrivateTmp=yes
NoNewPrivileges=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
